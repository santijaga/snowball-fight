<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="MenuStyles.uss" />
    <ui:VisualElement name="MenuSidebar" class="menu-sidebar dark-panel">
        <ui:VisualElement name="SidebarTabs" class="sidebar-tabs">
            <ui:VisualElement name="InventoryMenuItem" class="sidebar-button" focusable="true" tabindex="-1" picking-mode="Ignore">
                <ui:Label name="InventoryMenuLabel" class="menu-item-label" picking-mode="Ignore" />
                <ui:VisualElement class="menu-cursor" picking-mode="Ignore" focusable="false" />
            </ui:VisualElement>
            <ui:VisualElement name="StatusMenuItem" class="sidebar-button" focusable="true" tabindex="-1" picking-mode="Ignore">
                <ui:Label name="StatusMenuLabel" class="menu-item-label" picking-mode="Ignore" />
                <ui:VisualElement name="MenuCursor" class="menu-cursor" picking-mode="Ignore" focusable="false" />
            </ui:VisualElement>
            <ui:VisualElement name="SettingsMenuItem" class="sidebar-button" focusable="true" tabindex="-1" picking-mode="Ignore">
                <ui:Label name="SettingsMenuLabel" class="menu-item-label" picking-mode="Ignore" />
                <ui:VisualElement class="menu-cursor" picking-mode="Ignore" focusable="false" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
