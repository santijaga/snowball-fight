    m_Localized: "\u041B\u0435\u0432\u044B\u0439 \u0431\u0430\u043C\u043F\u0435\u0440
      (LB / L1)"
    m_Metadata:
      m_Items: []
  - m_Id: 1095959845359616
    m_Localized: '{0}: {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 1095959916662784
    m_Localized: "\u042D\u0442\u0430 \u043A\u043E\u043C\u043D\u0430\u0442\u0430 \u0431\u044B\u043B\u0430
      \u0437\u0430\u043A\u0440\u044B\u0442\u0430. \u041A\u0442\u043E \u0442\u044B
      \u0438 \u043A\u0430\u043A \u0442\u044B \u0442\u0443\u0442 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1095959916662785
    m_Localized: "\u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 \u0428\u0430\u044F.
      \u042F \u043E\u0445\u043E\u0442\u043D\u0438\u0446\u0430 \u0441 \u044E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1095959916662786
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u044F \u043D\u0430\u0448\u043B\u0430
      \u044D\u0442\u0443 \u043A\u043E\u043C\u043D\u0430\u0442\u0443, \u0434\u0432\u0435\u0440\u044C
      \u0431\u044B\u043B\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1095959916662787
    m_Localized: "\u041D\u043E \u043A\u043E\u0433\u0434\u0430 \u044F \u0432\u043E\u0448\u043B\u0430,
      \u0434\u0432\u0435\u0440\u044C \u0437\u0430\u0445\u043B\u043E\u043F\u043D\u0443\u043B\u0430\u0441\u044C
      \u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u043E\u0434\u0434\u0430\u043B\u0430\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1095959916662788
    m_Localized: "\u0425\u0432\u0430\u043B\u0430 \u0412\u0435\u043B\u0438\u043A\u043E\u043C\u0443
      \u0413\u0435\u043F\u0430\u0440\u0434\u0443, \u044F \u043F\u0440\u043E\u0431\u044B\u043B\u0430
      \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0447\u0430\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1095959916662789
    m_Localized: "\u0410 \u0441\u0430\u043C-\u0442\u043E \u0442\u044B \u043A\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 1095959916662790
    m_Localized: "\u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 \u0414\u0430\u0440\u0438\u0443\u0441.
      \u042F \u043F\u0440\u0438\u0431\u044B\u043B \u0441\u044E\u0434\u0430 \u0441
      \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0435\u043C \u043E\u0442 \u0418\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1095959916662791
    m_Localized: "\u0410 \u0437\u0430\u0447\u0435\u043C \u043E\u0445\u043E\u0442\u043D\u0438\u0446\u0430
      \u0441 \u044E\u0433\u0430 \u043F\u0440\u0438\u0431\u044B\u043B\u0430 \u043D\u0430
      \u0437\u0435\u043C\u043B\u0438 \u0418\u043C\u043F\u0435\u0440\u0438\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 1095959916662792
    m_Localized: "\u042F \u043D\u0435 \u043C\u043E\u0433\u0443 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u044C
      \u0442\u0435\u0431\u0435 \u0441\u0432\u043E\u044E \u0446\u0435\u043B\u044C.
      \u042F \u043F\u043E\u043A\u043B\u044F\u043B\u0430\u0441\u044C \u0441\u0432\u043E\u0438\u043C
      \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430\u043C, \u0447\u0442\u043E
      \u0438\u0445 \u0432\u043E\u043B\u044F \u0431\u0443\u0434\u0435\u0442 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0430
      \u0432 \u0442\u0430\u0439\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1095959916662793
    m_Localized: "\u0411\u043E\u044E\u0441\u044C, \u043C\u043D\u0435 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u043D\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u0442\u044C, \u0447\u0442\u043E\u0431\u044B
      \u0442\u044B \u0445\u043E\u0442\u044F \u0431\u044B \u043F\u043E\u0448\u043B\u0430
      \u0441\u043E \u043C\u043D\u043E\u0439. \u042F \u043D\u0435 \u043C\u043E\u0433\u0443
      \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C \u0442\u0435\u0431\u0435
      \u0431\u0440\u043E\u0434\u0438\u0442\u044C \u0442\u0443\u0442 \u043E\u0434\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1095959916662794
    m_Localized: "\u0425\u0430. \u041C\u043D\u0435 \u043D\u0435 \u043D\u0443\u0436\u0435\u043D
      \u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 1095959916662795
    m_Localized: "\u042F \u043D\u0435 \u043F\u044B\u0442\u0430\u044E\u0441\u044C
      \u0442\u0435\u0431\u044F \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C.
      \u041C\u043D\u0435 \u0442\u0430\u043A \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u043E\u0449\u0435
      \u0437\u0430 \u0442\u043E\u0431\u043E\u0439 \u0441\u043B\u0435\u0434\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1095959916662796
    m_Localized: "\u041C\u043D\u0435 \u043D\u0435\u0447\u0435\u0433\u043E \u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C,
      \u0438 \u044F \u043D\u0435 \u0432\u0440\u0430\u0433 \u0442\u0435\u0431\u0435,
      \u043F\u043E\u043A\u0430 \u0442\u044B \u043D\u0435 \u043B\u0435\u0437\u0435\u0448\u044C
      \u0432 \u043C\u043E\u0438 \u0434\u0435\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1095959916662797
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043F\u0440\u043E\u0431\u043B\u0435\u043C
      \u043D\u0435 \u0432\u043E\u0437\u043D\u0438\u043A\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1201726493642752
    m_Localized: "\u0414\u0430, \u043A\u0441\u0442\u0430\u0442\u0438, \u044F \u043E\u0449\u0443\u0449\u0430\u044E
      \u0432\u0435\u0442\u0435\u0440 \u0438\u0437 \u0441\u0442\u0435\u043D\u044B
      \u0441\u043F\u0440\u0430\u0432\u0430 \u043E\u0442 \u043C\u0435\u043D\u044F.
      \u041F\u043E\u0445\u043E\u0436\u0435, \u0442\u0430\u043C \u0447\u0442\u043E-\u0442\u043E
      \u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1202824067502080
    m_Localized: "\u0420\u0436\u0430\u0432\u044B\u0439 \u043A\u043B\u044E\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 1202824067502081
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0440\u0436\u0430\u0432\u044B\u0439
      \u043A\u043B\u044E\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 1226484304138240
    m_Localized: "\u0412\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438
      {0}. \u041E\u0442\u043A\u0440\u044B\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 4087462964318208
    m_Localized: "\u041C\u043E\u0438 \u043D\u0430\u0432\u044B\u043A\u0438 \u0445\u043E\u0440\u043E\u0448\u0438,
      \u043D\u043E \u043D\u0435 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E,
      \u0447\u0442\u043E\u0431\u044B \u0442\u044B \u043C\u0435\u043D\u044F \u043D\u0435
      \u0437\u0430\u043C\u0435\u0442\u0438\u043B!"
    m_Metadata:
      m_Items: []
  - m_Id: 4091672858546176
    m_Localized: "\u0410 \u0442\u044B \u043A\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 4091672908877824
    m_Localized: "\u042F \u0438\u0434\u0443 \u0441 \u0442\u043E\u0431\u043E\u0439.
      \u041E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F \u0437\u0434\u0435\u0441\u044C
      \u043E\u0434\u043D\u043E\u0439 \u0431\u0443\u0434\u0435\u0442 \u0431\u0435\u0437\u0443\u043C\u0438\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 4091672908877825
    m_Localized: "\u041A\u0430\u043A \u0445\u043E\u0447\u0435\u0448\u044C, \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0435 \u043F\u0443\u0442\u0430\u0439\u0441\u044F \u043F\u043E\u0434
      \u043D\u043E\u0433\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 4845788773830656
    m_Localized: "\u041D\u0435\u043A\u0440\u043E\u043C\u0430\u043D\u0442"
    m_Metadata:
