  - m_Id: 3846524940
    m_Localized: "\u0412\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C:
      {0} / {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 3846524941
    m_Localized: "\u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442: {0} / {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 3846524942
    m_Localized: "\u041F\u0443\u0441\u0442\u043E... \u041D\u0430\u0434\u043E \u0431\u044B
      \u0442\u0443\u0434\u0430 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0443\u0436\u0435 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 3846524943
    m_Localized: "\u041D\u0430\u0434\u043E \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C
      \u0432 \u0447\u0435\u043C \u043F\u043E\u0439\u0442\u0438. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
      \u043E\u0431\u0435\u0449\u0430\u043B\u0438 \u043C\u043E\u0440\u043E\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 3846524944
    m_Localized: "\u041E! \u0427\u0442\u043E \u044D\u0442\u043E?! \u041A\u0430\u043A
      \u0441\u0442\u0440\u0430\u043D\u043D\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 3846524945
    m_Localized: "\u0417\u0430\u043F\u0435\u0440\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 70407843827712
    m_Localized: "\u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 70407906742272
    m_Localized: "\u041A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 70407906742273
    m_Localized: "\u0417\u0435\u043B\u044C\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 70407906742274
    m_Localized: "\u041C\u0430\u043B\u044B\u0439 \u0444\u043B\u0430\u043A\u043E\u043D
      \u0446\u0435\u043B\u0435\u0431\u043D\u043E\u0439 \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u0438.
      \u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      50 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 70407906742275
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0439 \u043C\u0435\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 70407906742276
    m_Localized: "\u041C\u0435\u0447 \u0441 \u0434\u043B\u0438\u043D\u043D\u044B\u043C
      \u043F\u0440\u044F\u043C\u044B\u043C \u043A\u043B\u0438\u043D\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 70407906742277
    m_Localized: "\u0411\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0439 \u043A\u043B\u044E\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 70407906742278
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0439
      \u043A\u043B\u044E\u0447."
    m_Metadata:
      m_Items: []
